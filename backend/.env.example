NODE_ENV=development
PORT=3000
# Allowed browser origin(s), comma separated. Required in production.
FRONTEND_URL=http://localhost:5173

# Supabase Postgres. DATABASE_URL = pooled (port 6543, pgbouncer), DIRECT_URL = direct (5432) for migrations.
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connect_timeout=30&pool_timeout=30&connection_limit=5
DIRECT_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Supabase Auth
SUPABASE_URL=https://<ref>.supabase.co
# Server-only. Never ship this to the frontend.
SUPABASE_SERVICE_ROLE_KEY=
# Optional: JWT secret for HS256 projects. Leave empty to verify via the project JWKS endpoint.
SUPABASE_JWT_SECRET=

# When set, registering as a teacher requires this code. Leave empty to let
# anyone register as a teacher (fine for a demo, not for real use).
TEACHER_INVITE_CODE=

# Set to true behind a load balancer so rate limits use the real client address.
TRUST_PROXY=false
# debug | info | warn | error. Defaults to debug in development, info in production.
LOG_LEVEL=
